(define (domain shared-achiever)
  (:requirements :strips :negative-preconditions :numeric-fluents)
  (:predicates (fresh) (ready) (s) (g1) (g2) (g3) (g4) (g5) (p1) (p2) (p3))
  (:functions (x))
  (:action start :parameters () :precondition (and (fresh) (>= (x) 0)) :effect (and (ready) (not (fresh))))
  (:action b :parameters () :precondition (ready) :effect (s))
  (:action all :parameters () :precondition (s) :effect (and (g1) (g2) (g3) (g4) (g5)))
  (:action o1 :parameters () :precondition (ready) :effect (g1))
  (:action o2 :parameters () :precondition (ready) :effect (g2))
  (:action o3 :parameters () :precondition (ready) :effect (g3))
  (:action o4 :parameters () :precondition (ready) :effect (g4))
  (:action o5 :parameters () :precondition (ready) :effect (g5))
  (:action c1 :parameters () :precondition (fresh) :effect (and (p1) (not (fresh))))
  (:action c2 :parameters () :precondition (p1) :effect (p2))
  (:action c3 :parameters () :precondition (p2) :effect (p3))
  (:action c4 :parameters () :precondition (p3) :effect (and (g1) (g2) (g3) (g4) (g5))))
