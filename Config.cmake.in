@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Dependencies

include("${CMAKE_CURRENT_LIST_DIR}/cmake/bootstrap_pyyggdrasil.cmake")

find_dependency(yggdrasil @TYR_YGGDRASIL_REQUIRED_VERSION@ CONFIG PATHS ${CMAKE_PREFIX_PATH} NO_DEFAULT_PATH)

yggdrasil_find_python_native_prefix(pypddl LOKI_NATIVE_PREFIX)
yggdrasil_register_native_dependency_prefix("${YGGDRASIL_NATIVE_PREFIX}")
yggdrasil_register_native_dependency_prefix("${LOKI_NATIVE_PREFIX}")

find_dependency(loki @TYR_LOKI_REQUIRED_VERSION@ CONFIG COMPONENTS parsers PATHS ${CMAKE_PREFIX_PATH} NO_DEFAULT_PATH)
find_dependency(Boost 1.74.0 REQUIRED COMPONENTS json PATHS ${CMAKE_PREFIX_PATH} NO_DEFAULT_PATH)

# Components

set(_tyr_supported_components core)
if(NOT tyr_FIND_COMPONENTS)
    set(tyr_FIND_COMPONENTS core)
endif()

foreach(_component IN LISTS tyr_FIND_COMPONENTS)
    if(_component IN_LIST _tyr_supported_components)
        set(tyr_${_component}_FOUND TRUE)
    else()
        set(tyr_${_component}_FOUND FALSE)
        if(tyr_FIND_REQUIRED_${_component})
            set(tyr_FOUND FALSE)
            set(tyr_NOT_FOUND_MESSAGE "Unsupported component: ${_component}")
            unset(_component)
            unset(_tyr_supported_components)
            return()
        endif()
    endif()
endforeach()

# Targets

include("${CMAKE_CURRENT_LIST_DIR}/tyrcoreTargets.cmake")

unset(_component)
unset(_tyr_supported_components)
